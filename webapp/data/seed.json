              "number": 3, "contentHash": "a71ccd2aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "title": "Few-shot examples",
              "body": "You are a careful, precise assistant that classifies customer-support tickets.\n\nClassify the ticket into exactly one of: billing, account, product, other.\nRespond with a single word, lowercase, no punctuation.\n\nExamples:\nTicket: \"I was charged twice for my subscription.\" → billing\nTicket: \"My password reset link never arrives.\" → account\nTicket: \"The export button crashes the app.\" → product\n\nTicket:\n{{ticket}}",
              "messages": null, "status": "candidate",
              "variables": [{ "name": "ticket", "description": "Raw ticket text", "type": "string", "required": true }],
              "changeSummary": "Add three few-shot examples", "rationale": "Accuracy was drifting on edge cases.", "expectedImprovement": "Better adherence to the single-word format.",
              "createdAt": 1713805000000, "createdBy": "belkis"
            },
            {
              "id": "ver_4", "promptId": "prm_ticket", "parentVersionId": "ver_3", "createdOnBranchId": "br_json",
              "number": 4, "contentHash": "8577991aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "title": "Return JSON with confidence",
              "body": "You are a careful, precise assistant that classifies customer-support tickets.\n\nClassify the ticket into exactly one of: billing, account, product, other.\nReturn a JSON object with the following fields: { \"label\": string, \"confidence\": number }. Return valid JSON only.\n\nTicket:\n{{ticket}}",
              "messages": null, "status": "experimental",
              "variables": [{ "name": "ticket", "description": "Raw ticket text", "type": "string", "required": true }],
              "changeSummary": "Switch to structured JSON output", "rationale": "Downstream consumer needs confidence scores.", "expectedImprovement": "Machine-parseable output with a confidence.",
              "createdAt": 1713820000000, "createdBy": "belkis"
            },
            {
              "id": "ver_5", "promptId": "prm_ticket", "parentVersionId": "ver_3", "createdOnBranchId": "br_few_shot",
              "number": 5, "contentHash": "f0fdf7aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "title": "Tighten edge-case handling",
              "body": "You are a careful, precise assistant that classifies customer-support tickets.\n\nClassify the ticket into exactly one of: billing, account, product, other.\nRespond with a single word, lowercase, no punctuation.\nIf multiple categories apply, pick the one most tied to the user's immediate blocker.\n\nExamples:\nTicket: \"I was charged twice for my subscription.\" → billing\nTicket: \"My password reset link never arrives.\" → account\nTicket: \"The export button crashes the app.\" → product\nTicket: \"Is there a student discount?\" → other\n\nTicket:\n{{ticket}}",
              "messages": null, "status": "candidate",
              "variables": [{ "name": "ticket", "description": "Raw ticket text", "type": "string", "required": true }],
              "changeSummary": "Add an 'other' example + tie-breaker rule.",
              "rationale": "'Is there a student discount?' was drifting between billing and other.",
              "expectedImprovement": "Consistent 'other' handling for non-issue questions.",
              "createdAt": 1713840000000, "createdBy": "belkis"
            },
            {
              "id": "ver_6", "promptId": "prm_ticket", "parentVersionId": "ver_5", "createdOnBranchId": "br_refine",
              "number": 6, "contentHash": "eccc6aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "title": "Refined: ambiguity rule",
              "body": "You are a careful, precise assistant that classifies customer-support tickets.\n\nClassify the ticket into exactly one of: billing, account, product, other.\nRespond with a single word, lowercase, no punctuation.\nIf multiple categories apply, pick the one most tied to the user's immediate blocker.\nIf the ticket is unclear, respond with 'other' rather than guessing.\n\nExamples:\nTicket: \"I was charged twice for my subscription.\" → billing\nTicket: \"My password reset link never arrives.\" → account\nTicket: \"The export button crashes the app.\" → product\nTicket: \"Is there a student discount?\" → other\n\nTicket:\n{{ticket}}",
              "messages": null, "status": "experimental",
              "variables": [{ "name": "ticket", "description": "Raw ticket text", "type": "string", "required": true }],
              "changeSummary": "Add explicit unclear-input rule.", "rationale": "A few ambiguous tickets were still being misclassified.", "expectedImprovement": "Fewer wrong guesses on ambiguous inputs.",
              "createdAt": 1713860000000, "createdBy": "belkis"
            }
