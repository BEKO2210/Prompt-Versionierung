# Database (SQLite for dev; change to postgres://... for prod)
DATABASE_URL="file:./prisma/dev.db"

# Default model provider for the mock adapter. Values: mock | anthropic
MODEL_PROVIDER="mock"

# Only used when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=""

# Default model identifier used when no ModelProfile is selected
DEFAULT_MODEL_ID="claude-opus-4-7"
